    },
    "slidePhase": {
      "kind": "phasor",
      "value": "f32",
      "phasor": {
        "period_seconds": 110.0,
        "waveform": "ramp",
        "phase_offset": 0.0
      },
      "default": 0,
      "label": "Slide",
      "description": "Position on the field's closed slide loop (0-1)"
    },
    "palette": {
      "kind": "palette",
      "value": "sampler2D",
      "label": "Palette",
      "description": "The bands step through this ramp from its dark end up",
      "gradient": {
        "kind": "static",
        "step_seconds": 0.0,
        "fade_seconds": 0.0,
        "set": [
          {
            "space": "oklab",
            "method": "linear",
            "stops": "(0.22,0.03,-0.1) (0.45,0.16,-0.12) (0.63,0.19,0.03) (0.76,0.08,0.14) (0.86,0.0,0.16)"
          }
        ]
      }
    }
  }
}
