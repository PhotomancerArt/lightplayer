{
  "kind": "Shader",
  "source": "shader.glsl",
  "render_order": 0,
  "coords": "pattern",
  "bindings": {
    "output": {
      "target": "bus:visual.out"
    },
    "detail": {
      "source": "bus:detail"
    },
    "steps": {
      "source": "bus:steps"
    },
    "palette": {
      "source": "bus:palette"
    }
  },
  "consumed": {
    "detail": {
      "kind": "value",
      "value": "f32",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "label": "Detail",
      "description": "Band shape size: 1 is a few shapes across the piece; 2 halves them"
    },
    "steps": {
      "kind": "value",
      "value": "f32",
      "default": 4,
      "min": 2,
      "max": 8,
      "label": "Steps",
