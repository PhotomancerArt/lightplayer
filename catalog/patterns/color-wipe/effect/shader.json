{
  "kind": "Shader",
  "source": "shader.glsl",
  "render_order": 0,
  "coords": "pattern",
  "bindings": {
    "output": {
      "target": "bus:visual.out"
    },
    "detail": {
      "source": "bus:detail"
    },
    "angle": {
      "source": "bus:angle"
    },
    "palette": {
      "source": "bus:palette"
    }
  },
  "consumed": {
    "detail": {
      "kind": "value",
      "value": "f32",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "label": "Detail",
      "description": "Sharpness of the wipe's edge: 1 is about a lamp and a half soft; 2 is twice as crisp"
