{
  "$id": "https://lightplayer.dev/schemas/project.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Workspace identity of a project folder: format version, library uid, and display name. Not a node artifact — the root module node lives in module.json.",
  "properties": {
    "format": {
      "const": 5,
      "title": "Authored format version"
    },
    "name": {
      "title": "Human-readable project name",
      "type": "string"
    },
    "uid": {
      "title": "Stable project identity (prj_…, base-62)",
      "type": "string"
    }
  },
  "required": [
    "format"
  ],
  "title": "LightPlayer project container manifest",
  "type": "object"
}
