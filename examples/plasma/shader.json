{
  "kind": "Shader",
  "source": "shader.glsl",
  "render_order": 0,
  "bindings": {
    "output": {
      "target": "bus:visual.out"
    },
    "scale": {
      "source": "bus:scale"
    },
    "phase": {
      "source": "bus:speed"
    }
  },
  "float_mode": "fixed",
  "consumed": {
    "scale": {
      "kind": "value",
      "value": "f32",
      "default": 1,
      "min": 0.25,
      "max": 4,
      "label": "Scale",
      "description": "Spatial frequency of the folded sine fields"
    },
    "phase": {
      "kind": "phasor",
      "value": "f32",
      "phasor": {
        "period_seconds": 100.0,
        "waveform": "ramp",
        "phase_offset": 0.0
      },
      "default_bind": "bus:speed",
      "default": 0,
      "label": "Phase",
      "description": "Plasma base cycle position (0-1); every field rides a whole multiple of it"
    }
  }
}
