{
  "id": "espressif/esp32-c6-devkitc-1",
  "target": "esp32c6",
  "vendor": "espressif",
  "product": "ESP32-C6-DevKitC-1",
  "description": "Espressif ESP32-C6-DevKitC-1 board profile (v1.2 pin layout). Header silkscreen labels are the GPIO numbers themselves; TX/RX are GPIO16/17. Sourced from Espressif's board documentation, not yet hardware-calibrated.",
  "url": "https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32c6/esp32-c6-devkitc-1/index.html",
  "board_label": [
    {
      "label": "TX",
      "gpio": "/gpio/16",
      "status": "assigned",
      "note": "UART0 TXD per the v1.2 pin layout; not yet hardware-verified"
    },
    {
      "label": "RX",
      "gpio": "/gpio/17",
      "status": "assigned",
      "note": "UART0 RXD per the v1.2 pin layout; not yet hardware-verified"
    },
    {
      "label": "RGB",
      "gpio": "/gpio/8",
      "status": "assigned",
      "note": "onboard WS2812 per Espressif docs; also a boot-strap pin"
    },
    {
      "label": "BOOT",
      "gpio": "/gpio/9",
      "status": "assigned",
      "note": "BOOT button; boot-strap pin"
    }
  ],
  "gpio": [
    {
