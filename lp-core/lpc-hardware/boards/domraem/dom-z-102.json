{
  "id": "domraem/dom-z-102",
  "target": "esp32",
  "vendor": "domraem",
  "product": "DOM-Z-102",
  "description": "Domraem DOM-Z-102 classic-ESP32 (LX6, rev v3.x, 4 MB flash) 4-output WS281x controller — the classic bring-up roadmap's desk board and WLED-class deployment exemplar. Data channels verified against the board silkscreen (display sidecar authored from a photo of this exact unit); GPIO capabilities are listed only for pins the board actually exposes. Host link is UART0 through an onboard CH340K bridge (0x1A86:0x7522) — macOS needs the WCH VCP driver before a serial port appears at all; see the fw-esp32v3 README.",
  "board_label": [
    {
      "label": "LED1",
      "gpio": "/gpio/18",
      "status": "assigned"
    },
    {
      "label": "LED2",
      "gpio": "/gpio/16",
      "status": "assigned"
    },
    {
      "label": "LED3",
      "gpio": "/gpio/14",
      "status": "assigned"
    },
    {
      "label": "LED4",
      "gpio": "/gpio/2",
      "status": "assigned",
      "note": "classic-ESP32 strapping pin (boot mode); must be low/floating at reset, which a WS281x data line satisfies — fine as an output once booted"
    }
  ],
  "gpio": [
    {
      "address": "/gpio/0",
      "display_label": "GPIO0",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO0"
      ],
      "reserved_reason": "BOOT strapping pin, wired to the board's OPT button; not exposed as an output terminal"
    },
    {
      "address": "/gpio/1",
      "display_label": "GPIO1",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO1",
        "U0TXD"
      ],
      "reserved_reason": "UART0 TX into the CH340K bridge — the host serial link; driving it drops the link"
    },
    {
      "address": "/gpio/2",
      "display_label": "LED4",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO2",
        "GPIO2"
      ]
    },
    {
      "address": "/gpio/3",
      "display_label": "GPIO3",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO3",
        "U0RXD"
      ],
      "reserved_reason": "UART0 RX from the CH340K bridge — the host serial link; driving it drops the link"
    },
    {
      "address": "/gpio/14",
      "display_label": "LED3",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO14",
        "GPIO14"
      ]
    },
    {
      "address": "/gpio/16",
      "display_label": "LED2",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO16",
        "GPIO16"
      ]
    },
    {
      "address": "/gpio/18",
      "display_label": "LED1",
      "capabilities": [
        "gpio-output",
        "gpio-input"
      ],
      "aliases": [
        "IO18",
        "GPIO18"
      ]
    }
  ],
  "resource": [
    {
      "address": "/rmt/ws281x0",
      "display_label": "RMT WS281x 0",
      "capabilities": [
        "rmt",
        "ws281x-output"
      ]
    },
    {
