{
  "id": "seeed/xiao-esp32-s3-plus",
  "target": "esp32s3",
  "vendor": "seeed",
  "product": "XIAO ESP32-S3 Plus",
  "description": "Seeed Studio XIAO ESP32-S3 Plus board profile. Enumerates the D0-D10 header pins plus the pins it is unsafe to drive; the user LED and the 1.27 mm castellated pads are deliberately absent because no verified GPIO map exists for them.",
  "url": "https://www.seeedstudio.com/Seeed-Studio-XIAO-ESP32S3-Plus-p-6361.html",
  "board_label": [
    {
      "label": "D0",
      "gpio": "/gpio/1",
      "status": "assigned"
    },
    {
      "label": "D1",
      "gpio": "/gpio/2",
      "status": "assigned"
    },
    {
      "label": "D2",
      "gpio": "/gpio/3",
      "status": "assigned",
      "note": "ESP32-S3 strapping pin (JTAG source select); free as a GPIO once booted"
    },
    {
      "label": "D3",
      "gpio": "/gpio/4",
      "status": "assigned"
    },
    {
      "label": "D4",
      "gpio": "/gpio/5",
      "status": "assigned",
      "note": "default I2C SDA"
    },
    {
      "label": "D5",
      "gpio": "/gpio/6",
      "status": "assigned",
      "note": "default I2C SCL"
    },
    {
      "label": "D6",
      "gpio": "/gpio/43",
      "status": "assigned",
      "note": "UART0 TX; the ROM bootloader console, though this board's host link is USB-Serial-JTAG"
    },
    {
      "label": "D7",
      "gpio": "/gpio/44",
      "status": "assigned",
      "note": "UART0 RX; see D6"
    },
    {
      "label": "D8",
      "gpio": "/gpio/7",
      "status": "assigned",
      "note": "default SPI SCK"
    },
    {
      "label": "D9",
      "gpio": "/gpio/8",
      "status": "assigned",
      "note": "default SPI MISO"
    },
    {
      "label": "D10",
      "gpio": "/gpio/9",
      "status": "assigned",
      "note": "default SPI MOSI. espboards.dev claims this pin is tied to external flash; that is wrong for the ESP32-S3, whose in-package flash and PSRAM use GPIO26-GPIO37 only."
    }
  ],
