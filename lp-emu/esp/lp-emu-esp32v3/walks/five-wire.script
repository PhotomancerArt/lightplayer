after "\"id\":7," "M!{\"id\":8,\"msg\":{\"filesystem\":{\"write\":{\"path\":\"/projects/Five w"
then +20ms "ire/shader.glsl\",\"data\":\"// Deterministic, time-invariant test p"
then +20ms "attern.\\n//\\n// This project exists to be rendered on two target"
then +20ms "s and compared BYTE FOR\\n// BYTE, so it must consume no clock: e"
then +20ms "very frame is identical, and the only\\n// remaining variable bet"
then +20ms "ween a host render and a device render is the shader\\n// compile"
then +20ms "r/executor under test.\\n//\\n// It is not decorative. It reaches "
then +20ms "for the operations an on-device JIT is most\\n// likely to get su"
then +20ms "btly wrong: a divide, a square root, a two-argument arctan,\\n// "
then +20ms "transcendentals through the builtin table, a data-dependent bran"
then +20ms "ch, and a\\n// helper call that cannot be folded into its caller."
then +20ms " A pattern of flat ramps\\n// would render \\\"plausibly\\\" through "
then +20ms "a half-broken backend.\\n\\nlayout(binding = 0) uniform vec2 outpu"
then +20ms "tSize;\\n\\n// Data-dependent branch. Triangle wave over one unit "
then +20ms "of x.\\nfloat ridge(float x) {\\n    float f = fract(x);\\n    if ("
then +20ms "f < 0.5) {\\n        return f * 2.0;\\n    }\\n    return (1.0 - f)"
then +20ms " * 2.0;\\n}\\n\\n// Three cosines out of the builtin table, kept in"
then +20ms "side [0,1].\\nvec3 palette(float t) {\\n    return clamp(\\n       "
then +20ms " vec3(\\n            0.5 + 0.5 * cos(6.2831853 * (t + 0.00)),\\n  "
then +20ms "          0.5 + 0.5 * cos(6.2831853 * (t + 0.33)),\\n            "
then +20ms "0.5 + 0.5 * cos(6.2831853 * (t + 0.67))\\n        ),\\n        0.0"
then +20ms ",\\n        1.0\\n    );\\n}\\n\\nvec4 render_2d(vec2 pos) {\\n    vec"
then +20ms "2 uv = pos / outputSize;\\n    vec2 c = uv - vec2(0.5, 0.5);\\n\\n "
then +20ms "   float r = sqrt(c.x * c.x + c.y * c.y);\\n    float a = atan(c."
then +20ms "y, c.x) / 6.2831853 + 0.5;\\n\\n    float band = ridge(r * 4.0);\\n"
then +20ms "    float swirl = fract(a * 3.0 + r * 2.0);\\n    float t = mix(b"
then +20ms "and, swirl, 0.5);\\n\\n    float v = smoothstep(0.0, 1.0, 1.0 - r)"
then +20ms ";\\n    return vec4(palette(t) * v, 1.0);\\n}\\n\"}}}}\n"
