after "\"id\":7," "M!{\"id\":8,\"msg\":{\"filesystem\":{\"write\":{\"path\":\"/projects/Shader"
then +20ms " oracle/shader.glsl\",\"data\":\"// Deterministic, time-invariant te"
then +20ms "st pattern.\\n//\\n// This project exists to be rendered on two ta"
then +20ms "rgets and compared BYTE FOR\\n// BYTE, so it must consume no cloc"
then +20ms "k: every frame is identical, and the only\\n// remaining variable"
then +20ms " between a host render and a device render is the shader\\n// com"
then +20ms "piler/executor under test.\\n//\\n// It is not decorative. It reac"
then +20ms "hes for the operations an on-device JIT is most\\n// likely to ge"
then +20ms "t subtly wrong: a divide, a square root, a two-argument arctan,\\"
then +20ms "n// transcendentals through the builtin table, a data-dependent "
then +20ms "branch, and a\\n// helper call that cannot be folded into its cal"
then +20ms "ler. A pattern of flat ramps\\n// would render \\\"plausibly\\\" thro"
then +20ms "ugh a half-broken backend.\\n\\nlayout(binding = 0) uniform vec2 o"
then +20ms "utputSize;\\n\\n// Data-dependent branch. Triangle wave over one u"
then +20ms "nit of x.\\nfloat ridge(float x) {\\n    float f = fract(x);\\n    "
then +20ms "if (f < 0.5) {\\n        return f * 2.0;\\n    }\\n    return (1.0 "
then +20ms "- f) * 2.0;\\n}\\n\\n// Three cosines out of the builtin table, kep"
then +20ms "t inside [0,1].\\nvec3 palette(float t) {\\n    return clamp(\\n   "
then +20ms "     vec3(\\n            0.5 + 0.5 * cos(6.2831853 * (t + 0.00)),"
then +20ms "\\n            0.5 + 0.5 * cos(6.2831853 * (t + 0.33)),\\n        "
then +20ms "    0.5 + 0.5 * cos(6.2831853 * (t + 0.67))\\n        ),\\n       "
then +20ms " 0.0,\\n        1.0\\n    );\\n}\\n\\nvec4 render_2d(vec2 pos) {\\n   "
then +20ms " vec2 uv = pos / outputSize;\\n    vec2 c = uv - vec2(0.5, 0.5);\\"
then +20ms "n\\n    float r = sqrt(c.x * c.x + c.y * c.y);\\n    float a = ata"
then +20ms "n(c.y, c.x) / 6.2831853 + 0.5;\\n\\n    float band = ridge(r * 4.0"
then +20ms ");\\n    float swirl = fract(a * 3.0 + r * 2.0);\\n    float t = m"
then +20ms "ix(band, swirl, 0.5);\\n\\n    float v = smoothstep(0.0, 1.0, 1.0 "
then +20ms "- r);\\n    return vec4(palette(t) * v, 1.0);\\n}\\n\"}}}}\n"
