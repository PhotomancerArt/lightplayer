after "\"id\":7," "M!{\"id\":8,\"msg\":{\"filesystem\":{\"write\":{\"path\":\"/projects/Meteor"
then +2ms "/render.glsl\",\"data\":\"struct Meteor {\\n    uint id;\\n    vec2 po"
then +2ms "s;\\n    vec2 dir;\\n    float radius;\\n    vec3 color;\\n    float"
then +2ms " velocity;\\n    float intensity;\\n};\\n\\nlayout(binding = 0) unif"
then +2ms "orm vec2 outputSize;\\nlayout(binding = 1) uniform Meteor meteors"
then +2ms "[4];\\nlayout(binding = 2) uniform float decay;\\n\\n// One meteor'"
then +2ms "s contribution: a bright head with an exponential tail behind\\n/"
then +2ms "/ it (the tail wraps with the head).\\n//\\n// The uniform array i"
then +2ms "s indexed with CONSTANT indices at the call site and\\n// its fie"
then +2ms "lds arrive as scalars/vectors: a runtime index into a uniform\\n/"
then +2ms "/ struct array has no uniform element address to lower against.\\"
then +2ms "n// `examples/events/shader.glsl` carries the same shape for the"
then +2ms " same reason.\\nvec3 drawMeteor(vec3 accum, uint id, vec2 head, v"
then +2ms "ec3 color, float intensity, vec2 uv) {\\n    if (id == 0u) {\\n   "
then +2ms "     return accum;\\n    }\\n    if (intensity <= 0.0) {\\n        "
then +2ms "return accum;\\n    }\\n    float behind = head.x - uv.x;\\n    if "
then +2ms "(behind < 0.0) {\\n        behind = behind + 1.0;\\n    }\\n    flo"
then +2ms "at tail = exp(-behind * decay * 6.0);\\n    float lane = 1.0 - sm"
then +2ms "oothstep(0.0, 0.45, abs(uv.y - head.y));\\n    return accum + col"
then +2ms "or * tail * lane * intensity;\\n}\\n\\nvec4 render_2d(vec2 pos) {\\n"
then +2ms "    vec2 uv = pos / outputSize;\\n    vec3 accum = vec3(0.0, 0.0,"
then +2ms " 0.0);\\n    accum = drawMeteor(accum, meteors[0].id, meteors[0]."
then +2ms "pos, meteors[0].color, meteors[0].intensity, uv);\\n    accum = d"
then +2ms "rawMeteor(accum, meteors[1].id, meteors[1].pos, meteors[1].color"
then +2ms ", meteors[1].intensity, uv);\\n    accum = drawMeteor(accum, mete"
then +2ms "ors[2].id, meteors[2].pos, meteors[2].color, meteors[2].intensit"
then +2ms "y, uv);\\n    accum = drawMeteor(accum, meteors[3].id, meteors[3]"
then +2ms ".pos, meteors[3].color, meteors[3].intensity, uv);\\n    return v"
then +2ms "ec4(min(accum, vec3(1.0, 1.0, 1.0)), 1.0);\\n}\\n\"}}}}\n"
after "\"id\":8," "M!{\"id\":9,\"msg\":{\"filesystem\":{\"write\":{\"path\":\"/projects/Meteor"
then +2ms "/render.json\",\"data\":\"{\\n  \\\"kind\\\": \\\"Shader\\\",\\n  \\\"source\\\": "
then +2ms "\\\"render.glsl\\\",\\n  \\\"render_order\\\": 0,\\n  \\\"bindings\\\": {\\n   "
then +2ms " \\\"decay\\\": {\\n      \\\"source\\\": \\\"bus:decay\\\"\\n    },\\n    \\\"me"
then +2ms "teors\\\": {\\n      \\\"source\\\": \\\"node:../sim#meteors\\\"\\n    },\\n "
then +2ms "   \\\"output\\\": {\\n      \\\"target\\\": \\\"bus:visual.out\\\"\\n    }\\n "
then +2ms " },\\n  \\\"consumed\\\": {\\n    \\\"decay\\\": {\\n      \\\"kind\\\": \\\"valu"
then +2ms "e\\\",\\n      \\\"value\\\": \\\"f32\\\",\\n      \\\"default\\\": 3,\\n      \\\""
then +2ms "min\\\": 0.5,\\n      \\\"max\\\": 8,\\n      \\\"label\\\": \\\"Decay\\\",\\n   "
then +2ms "   \\\"description\\\": \\\"How fast each meteor's tail falls off\\\"\\n "
then +2ms "   },\\n    \\\"meteors\\\": {\\n      \\\"kind\\\": \\\"map\\\",\\n      \\\"val"
then +2ms "ue\\\": \\\"lp::fluid::Emitter\\\",\\n      \\\"key\\\": \\\"u32\\\",\\n      \\\""
then +2ms "default\\\": 0,\\n      \\\"mapping\\\": {\\n        \\\"kind\\\": \\\"sentine"
then +2ms "l\\\",\\n        \\\"len\\\": 4,\\n        \\\"key\\\": \\\"id\\\",\\n        \\\"e"
then +2ms "mpty_key\\\": 0\\n      },\\n      \\\"label\\\": \\\"\\\",\\n      \\\"descrip"
then +2ms "tion\\\": \\\"\\\"\\n    }\\n  }\\n}\\n\"}}}}\n"
after "\"id\":9," "M!{\"id\":10,\"msg\":{\"filesystem\":{\"write\":{\"path\":\"/projects/Meteo"
then +2ms "r/sim.glsl\",\"data\":\"// Meteor heads: per-meteor position/energy "
then +2ms "persisted across ticks in the\\n// produced map (compute globals "
then +2ms "are the engine's persistent state).\\nfloat prev_time;\\n\\nvoid ti"
then +2ms "ck() {\\n    float active = clamp(count, 1.0, 4.0);\\n\\n    if (me"
then +2ms "teors[0].id == 0u) {\\n        // Seed the clock alongside the ta"
then +2ms "ble so the first tick advances by\\n        // zero rather than b"
then +2ms "y the whole elapsed project time.\\n        prev_time = time;\\n\\n"
then +2ms "        meteors[0].id = 1u;\\n        meteors[0].pos = vec2(0.0, "
then +2ms "0.5);\\n        meteors[0].velocity = 0.22;\\n        meteors[0].c"
then +2ms "olor = vec3(1.0, 0.55, 0.15);\\n        meteors[0].radius = 0.14;"
then +2ms "\\n\\n        meteors[1].id = 2u;\\n        meteors[1].pos = vec2(0"
then +2ms ".4, 0.5);\\n        meteors[1].velocity = 0.31;\\n        meteors["
then +2ms "1].color = vec3(0.25, 0.55, 1.0);\\n        meteors[1].radius = 0"
then +2ms ".11;\\n\\n        meteors[2].id = 3u;\\n        meteors[2].pos = ve"
then +2ms "c2(0.7, 0.5);\\n        meteors[2].velocity = 0.26;\\n        mete"
then +2ms "ors[2].color = vec3(0.4, 1.0, 0.35);\\n        meteors[2].radius "
then +2ms "= 0.12;\\n\\n        meteors[3].id = 4u;\\n        meteors[3].pos ="
then +2ms " vec2(0.15, 0.5);\\n        meteors[3].velocity = 0.37;\\n        "
then +2ms "meteors[3].color = vec3(1.0, 0.3, 0.8);\\n        meteors[3].radi"
then +2ms "us = 0.09;\\n    }\\n\\n    // True elapsed time, deliberately UNCL"
then +2ms "AMPED: integrating constant\\n    // velocity over the real delta"
then +2ms " is exact at any frame rate, so the\\n    // meteors travel the s"
then +2ms "ame distance per second whether the tier renders\\n    // at 60fp"
then +2ms "s or 1fps. A clamp here (there was one) throttles motion on\\n   "
then +2ms " // slow frames only, which reads as stutter on the CPU tier whi"
then +2ms "le the\\n    // GPU tier looks fine.\\n    float dt = max(time - p"
then +2ms "rev_time, 0.0);\\n    prev_time = time;\\n\\n    meteors[0].pos = v"
then +2ms "ec2(mod(meteors[0].pos.x + meteors[0].velocity * speed * dt, 1.0"
then +2ms "), 0.5);\\n    meteors[1].pos = vec2(mod(meteors[1].pos.x + meteo"
then +2ms "rs[1].velocity * speed * dt, 1.0), 0.5);\\n    meteors[2].pos = v"
then +2ms "ec2(mod(meteors[2].pos.x + meteors[2].velocity * speed * dt, 1.0"
then +2ms "), 0.5);\\n    meteors[3].pos = vec2(mod(meteors[3].pos.x + meteo"
then +2ms "rs[3].velocity * speed * dt, 1.0), 0.5);\\n\\n    meteors[0].inten"
then +2ms "sity = 1.0;\\n    meteors[1].intensity = 0.0;\\n    meteors[2].int"
then +2ms "ensity = 0.0;\\n    meteors[3].intensity = 0.0;\\n    if (active >"
then +2ms "= 2.0) {\\n        meteors[1].intensity = 1.0;\\n    }\\n    if (ac"
then +2ms "tive >= 3.0) {\\n        meteors[2].intensity = 1.0;\\n    }\\n    "
then +2ms "if (active >= 4.0) {\\n        meteors[3].intensity = 1.0;\\n    }"
then +2ms "\\n}\\n\"}}}}\n"
after "\"id\":10," "M!{\"id\":11,\"msg\":{\"filesystem\":{\"write\":{\"path\":\"/projects/Meteo"
then +2ms "r/sim.json\",\"data\":\"{\\n  \\\"kind\\\": \\\"ComputeShader\\\",\\n  \\\"sourc"
