after "\"id\":7," "M!{\"id\":8,\"msg\":{\"filesystem\":{\"writeChunk\":{\"path\":\"/projects/B"
then +2ms "asic/shader.glsl\",\"offset\":0,\"data\":\"// 0=heatmap, 1=rainbow, 2="
then +2ms "fire, 3=cool, 4=warm (5s per palette, 1s lerp transition)\\n\\ncon"
then +2ms "st bool CYCLE_PALETTE = true;\\nconst float TAU = 6.28318530718;\\"
then +2ms "n\\n// Lygia heatmap: blue -> cyan -> green -> yellow -> red\\nvec"
then +2ms "3 paletteHeatmap(float t) {\\n    vec3 r = t * 2.1 - vec3(1.8, 1."
then +2ms "14, 0.3);\\n    return clamp(1.0 - r * r, 0.0, 1.0);\\n}\\n\\n// Lyg"
then +2ms "ia physical hue (neon rainbow)\\nvec3 paletteRainbow(float t) {\\n"
then +2ms "    float r = 0.33333;\\n    vec3 v = abs(mod(fract(1.0 - t) + ve"
then +2ms "c3(0.0, 1.0, 2.0) * r, 1.0) * 2.0 - 1.0);\\n    return v * v * (3"
then +2ms ".0 - 2.0 * v);\\n}\\n\\n// Lygia fire: black -> red -> orange -> ye"
then +2ms "llow -> white\\nvec3 paletteFire(float t) {\\n    return clamp(vec"
then +2ms "3(1.0, 0.25, 0.0625) * exp(4.0 * t - 1.0), 0.0, 1.0);\\n}\\n\\n// I"
then +2ms "\xc3\xb1igo Qu\xc3\xadlez parametric palette: cool blues/cyans\\nvec3 palette"
then +2ms "Cool(float t) {\\n    vec3 a = vec3(0.5, 0.5, 0.5);\\n    vec3 b ="
then +2ms " vec3(0.5, 0.5, 0.5);\\n    vec3 c = vec3(1.0, 1.0, 1.0);\\n    ve"
then +2ms "c3 d = vec3(0.25, 0.25, 0.25);\\n    return clamp(a + b * cos(6.2"
then +2ms "8318530718 * (c * t + d)), 0.0, 1.0);\\n}\\n\\n// I\xc3\xb1igo Qu\xc3\xadlez pa"
then +2ms "rametric palette: warm oranges/reds\\nvec3 paletteWarm(float t) {"
then +2ms "\\n    vec3 a = vec3(0.5, 0.5, 0.5);\\n    vec3 b = vec3(0.5, 0.5,"
then +2ms " 0.5);\\n    vec3 c = vec3(1.0, 1.0, 1.0);\\n    vec3 d = vec3(0.0"
then +2ms ", 0.1, 0.2);\\n    return clamp(a + b * cos(6.28318530718 * (c * "
then +2ms "t + d)), 0.0, 1.0);\\n}\\n\\nvec3 applyPalette(float t, float palet"
then +2ms "te) {\\n    // Add small epsilon to avoid Q32 rounding errors at "
then +2ms "boundaries (e.g. 3.99999 -> 3)\\n    float p = floor(palette + 0."
then +2ms "001);\\n    if (p < 0.5) return paletteHeatmap(t);\\n    if (p < 1"
then +2ms ".5) return paletteRainbow(t);\\n    if (p < 2.5) return paletteFi"
then +2ms "re(t);\\n    if (p < 3.5) return paletteCool(t);\\n    return pale"
then +2ms "tteWarm(t);\\n}\\n\\n// Naga GLSL-in resolves calls in source order"
then +2ms "; define helpers before render().\\nvec2 worley_demo(vec2 scaledC"
then +2ms "oord, float time) {\\n    float noiseValue = lpfn_worley(scaledCo"
then +2ms "ord * 2, 0u) / 2 + 0.5;\\n    float t = (cos(noiseValue * 3.1415 "
then +2ms "+ time) + 1.0) * 0.5;\\n    return vec2(t, 1.0);\\n}\\n\\nvec2 fbm_d"
then +2ms "emo(vec2 scaledCoord, float time) {\\n    float noiseValue = lpfn"
then +2ms "_fbm(scaledCoord, 3, 0u);\\n    float t = mod(time * 0.1 + (cos(n"
then +2ms "oiseValue * 3.1415 + time) + 1.0) * 0.5 / 3.0, 1.0);\\n    return"
then +2ms " vec2(t, 1.0);\\n}\\n\\nvec2 prsd_demo(vec2 scaledCoord, float time"
then +2ms ") {\\n    vec2 gradient;\\n    float noiseValue = lpfn_psrdnoise(\\"
then +2ms "n        scaledCoord,\\n        vec2(0.0),\\n        time,\\n      "
then +2ms "  gradient,\\n        0u\\n    );\\n\\n    float hue = (cos(noiseVal"
then +2ms "ue * 3.1415 + time) + 1.0) * 0.5;\\n    float gradientAngle = ata"
then +2ms "n(gradient.y, gradient.x) / (2.0 * 3.14159) + 0.5;\\n    float t "
then +2ms "= mod(time * 0.1 + hue / 3.0, 1.0);\\n    float v = mix(0.5, 1.0,"
then +2ms " gradientAngle);\\n    return vec2(t, v);\\n}\\n\\nlayout(binding = "
then +2ms "0) uniform vec2 outputSize;\\n// Unbounded seconds: the noise fie"
then +2ms "ld is advanced, not wrapped, so this one\\n// term genuinely want"
then +2ms "s the clock rather than a cycle position.\\nlayout(binding = 1) u"
then +2ms "niform float time;\\nlayout(binding = 2) uniform float palettePha"
then +2ms "se01;\\nlayout(binding = 3) uniform float panPhase;\\nlayout(bindi"
then +2ms "ng = 4) uniform float scalePhase;\\n\\nvec4 render_2d(vec2 pos) {\\"
then +2ms "n    // Virtual resolution: pattern matches a 32x32 render regar"
then +2ms "dless of outputSize.\\n    const vec2 REF_SIZE = vec2(32.0, 32.0)"
then +2ms ";\\n    vec2 virtCoord = pos * REF_SIZE / outputSize;\\n\\n    // P"
then +2ms "alette cycle: 5s per palette, 1s smooth transition to next.\\n   "
then +2ms " // Keep palette index and blend phase derived from one 25 s pha"
then +2ms "sor so\\n    // fixed-point boundary rounding cannot make them di"
then +2ms "sagree at the loop\\n    // point.\\n    float palettePhase = pale"
then +2ms "ttePhase01 * 5.0;\\n    float palette = min(floor(palettePhase), "
then +2ms "4.0);\\n    float cyclePhase = palettePhase - palette;\\n    float"
then +2ms " nextPalette = palette + 1.0;\\n    if (nextPalette > 4.5) {\\n   "
then +2ms "     nextPalette = 0.0;\\n    }\\n    float blend = smoothstep(0.8"
then +2ms ", 1.0, cyclePhase);\\n\\n    float pan = mix(1.0, 8.0, 0.5 * (sin("
then +2ms "TAU * panPhase) + 1.0));\\n\\n    float scale = mix(.04, .06, 0.5 "
then +2ms "* (sin(TAU * scalePhase) + 1.0));\\n\\n    vec2 center = REF_SIZE "
then +2ms "* 0.5;\\n    vec2 dir = virtCoord - center;\\n    vec2 scaledCoord"
then +2ms " = center + dir * scale;\\n\\n    vec2 tv = prsd_demo(scaledCoord,"
then +2ms " time);\\n    //vec2 tv = fbm_demo(scaledCoord, time);\\n    //vec"
then +2ms "2 tv = worley_demo(scaledC\"}}}}\n"
after "\"id\":8," "M!{\"id\":9,\"msg\":{\"filesystem\":{\"writeChunk\":{\"path\":\"/projects/B"
then +2ms "asic/shader.glsl\",\"offset\":4096,\"data\":\"oord, time);\\n\\n    if ("
then +2ms "CYCLE_PALETTE) {\\n        return vec4(mix(\\n            applyPal"
then +2ms "ette(tv.x, palette),\\n            applyPalette(tv.x, nextPalette"
then +2ms "),\\n            blend\\n        ) * tv.y, 1.0);\\n    } else {\\n  "
then +2ms "      return vec4(applyPalette(tv.x, 0) * tv.y, 1.0);\\n    }\\n}\\"
then +2ms "n\"}}}}\n"
