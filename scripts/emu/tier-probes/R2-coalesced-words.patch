+    /// R2 TIER PROBE (scripts/emu/tier-probes): the bulk driver.
+    ///
+    /// Today one `EV_WORD` is scheduled per word, and 96 % of the run's
+    /// 1.53 M slices are bounded by it. This consumes a **run** of words in
+    /// one go — each pulse still stamped with its own true cycle — and
+    /// schedules one `EV_WORD` at the run's end.
+    ///
+    /// The run stops **before** the word that raises the threshold, so that
+    /// word is fetched on its own, at its own cycle, and raises the interrupt
+    /// inline exactly as it does today. That is what makes the interrupt's
+    /// cycle provably unmoved (BD4) without a predicted-threshold event: the
+    /// guest sees the same interrupt at the same cycle, runs the same ISR and
+    /// retires the same instructions, and the only thing that vanishes is the
+    /// return to the machine between the words.
+    ///
+    /// It also means the bulk never reads a word the guest has not written
+    /// yet: everything in the run was already in the RAM when the run began,
+    /// because the refill that fills the next half is the one this run stops
+    /// in front of.
     fn fetch(&mut self, ch: usize, now: Cycles, cx: &mut BusCx<'_>) {
+        let mut at = now;
+        loop {
